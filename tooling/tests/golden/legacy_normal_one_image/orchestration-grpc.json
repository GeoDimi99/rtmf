{
 "containers": [
  {
   "cap_add": [
    "SYS_NICE"
   ],
   "cpuset_cpus": "0-7",
   "detach": true,
   "environment": {
    "GRPC_PORT": "50051",
    "TASK_NAME": "worker",
    "TASK_QUEUE_NAME": "worker"
   },
   "image": "worker",
   "ipc_mode": "host",
   "name": "task-service-worker",
   "network_mode": "host",
   "tmpfs": {
    "/tmp": "size=64m,mode=1777"
   },
   "tty": true,
   "ulimits": [
    {
     "Hard": 99,
     "Name": "rtprio",
     "Soft": 99
    },
    {
     "Hard": -1,
     "Name": "memlock",
     "Soft": -1
    }
   ],
   "volumes": {
    "/tmp/rtmo-grpc-ipc": {
     "bind": "/ipc",
     "mode": "rw"
    }
   }
  },
  {
   "cap_add": [
    "SYS_NICE"
   ],
   "cpuset_cpus": "0-7",
   "detach": true,
   "environment": {
    "GRPC_PORT": "50052",
    "TASK_NAME": "unused",
    "TASK_QUEUE_NAME": "unused"
   },
   "image": "unused",
   "ipc_mode": "host",
   "name": "task-service-unused",
   "network_mode": "host",
   "tmpfs": {
    "/tmp": "size=64m,mode=1777"
   },
   "tty": true,
   "ulimits": [
    {
     "Hard": 99,
     "Name": "rtprio",
     "Soft": 99
    },
    {
     "Hard": -1,
     "Name": "memlock",
     "Soft": -1
    }
   ],
   "volumes": {
    "/tmp/rtmo-grpc-ipc": {
     "bind": "/ipc",
     "mode": "rw"
    }
   }
  }
 ],
 "redis": {
  "schedule": {
   "description": "SCHED_NORMAL tasks with nice values",
   "iterations": "1",
   "length": "2",
   "name": "Fixture: non real-time",
   "version": "0.0.0"
  },
  "scheduletask:1": {
   "cpu_affinity": "7",
   "deadline": "250",
   "depends_on": "[]",
   "inputs": "{\"total_ops\": {\"type\": \"int\", \"value\": 16}}",
   "name": "worker",
   "outputs": "{\"result\": {\"type\": \"int\"}}",
   "policy": "normal",
   "priority": "-8",
   "service_port": "50051",
   "start": "0"
  },
  "scheduletask:2": {
   "cpu_affinity": "7",
   "deadline": "260",
   "depends_on": "[]",
   "inputs": "{}",
   "name": "worker",
   "outputs": "{}",
   "policy": "normal",
   "priority": "19",
   "service_port": "50051",
   "start": "250"
  }
 }
}
