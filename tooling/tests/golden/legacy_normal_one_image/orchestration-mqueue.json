{
 "containers": [
  {
   "cap_add": [
    "SYS_NICE",
    "IPC_LOCK"
   ],
   "cpuset_cpus": "0-7",
   "detach": true,
   "environment": {
    "TASK_NAME": "worker",
    "TASK_QUEUE_NAME": "worker"
   },
   "image": "worker",
   "ipc_mode": "host",
   "name": "worker",
   "remove": false,
   "ulimits": [
    {
     "Hard": 99,
     "Name": "rtprio",
     "Soft": 99
    },
    {
     "Hard": -1,
     "Name": "memlock",
     "Soft": -1
    }
   ]
  },
  {
   "cap_add": [
    "SYS_NICE",
    "IPC_LOCK"
   ],
   "cpuset_cpus": "0-7",
   "detach": true,
   "environment": {
    "TASK_NAME": "unused",
    "TASK_QUEUE_NAME": "unused"
   },
   "image": "unused",
   "ipc_mode": "host",
   "name": "unused",
   "remove": false,
   "ulimits": [
    {
     "Hard": 99,
     "Name": "rtprio",
     "Soft": 99
    },
    {
     "Hard": -1,
     "Name": "memlock",
     "Soft": -1
    }
   ]
  }
 ],
 "redis": {
  "schedule": {
   "description": "SCHED_NORMAL tasks with nice values",
   "iterations": "1",
   "length": "2",
   "name": "Fixture: non real-time",
   "version": "0.0.0"
  },
  "scheduletask:1": {
   "cpu_affinity": "7",
   "deadline": "250",
   "depends_on": "[]",
   "id": "10",
   "image": "worker",
   "inputs": "[{\"total_ops\": 16}]",
   "outputs": "{\"result\": \"int\"}",
   "policy": "normal",
   "priority": "-8",
   "start": "0"
  },
  "scheduletask:2": {
   "cpu_affinity": "7",
   "deadline": "260",
   "depends_on": "[]",
   "id": "11",
   "image": "worker",
   "inputs": "[{}]",
   "outputs": "{}",
   "policy": "normal",
   "priority": "19",
   "start": "250"
  }
 }
}
